#!/bin/bash
# cka —— CKA 真题练习与自动评分工具
CKA_ROOT="${CKA_ROOT:-/opt/cka}"
export CKA_ROOT WORKDIR="${WORKDIR:-/root/work}"
source "$CKA_ROOT/lib/common.sh" 2>/dev/null

list_tasks(){
  local dirs=$(ls -d "$CKA_ROOT"/tasks/*/ 2>/dev/null | sort)
  echo ""
  printf "%s %s %s %s %s\n" "${C_BOLD}$(padw 'ID' 4)${C_RST}" \
    "${C_BOLD}$(padw '题目' 44)${C_RST}" "${C_BOLD}$(padw '分类' 12)${C_RST}" \
    "${C_BOLD}$(padw '分值' 6)${C_RST}" "${C_BOLD}状态${C_RST}"
  echo "----------------------------------------------------------------------------------"
  for d in $dirs; do
    local meta="$d/meta.sh"
    [ -f "$meta" ] || continue
    ( source "$meta"
      local id=$(basename "$d" | cut -d- -f1)
      local st="${C_DIM}未做${C_RST}"
      is_done "$id" && st="${C_GREEN}已通过${C_RST}"
      printf "%s %s %s %s %b\n" "$(padw "$id" 4)" "$(padw "$TITLE" 44)" \
        "$(padw "$CATEGORY" 12)" "$(padw "$WEIGHT" 6)" "$st"
    )
  done
  echo "----------------------------------------------------------------------------------"
  local total=$(ls -d "$CKA_ROOT"/tasks/*/ 2>/dev/null | wc -l)
  echo "  进度：${C_BOLD}$(progress_count) / $total${C_RST} 题通过"
  echo "  用法：${C_CYAN}cka desc <ID>${C_RST} 看题 · ${C_CYAN}cka start <ID>${C_RST} 出题 · ${C_CYAN}cka check <ID>${C_RST} 评分 · ${C_CYAN}cka hint <ID>${C_RST} 提示 · ${C_CYAN}cka clean <ID>${C_RST} 清理"
  echo ""
}

find_task_dir(){
  local id="$1"
  local d=""
  if [ -d "$CKA_ROOT/tasks/$id" ]; then
    d="$CKA_ROOT/tasks/$id"
  else
    local pad
    pad=$(printf '%02d' "$id" 2>/dev/null)
    d=$(ls -d "$CKA_ROOT"/tasks/"$pad"*/ 2>/dev/null | head -1)
  fi
  [ -n "$d" ] && echo "$d" || return 1
}

cmd_desc(){
  local d=$(find_task_dir "$1") || { echo "找不到题目 $1，用 cka list 查看"; exit 1; }
  ( source "$d/meta.sh"
    echo ""
    echo "${C_BOLD}${C_CYAN}【题 $1】$TITLE${C_RST}  ${C_DIM}($CATEGORY · ${WEIGHT}分)${C_RST}"
    echo "────────────────────────────────────────────────────────────"
    echo "$DESCRIPTION"
    echo ""
  )
}

cmd_start(){
  local d=$(find_task_dir "$1") || { echo "找不到题目 $1"; exit 1; }
  echo "${C_YEL}==> 正在部署题 $1 的初始环境 ...${C_RST}"
  bash "$d/setup.sh"
  echo ""
  cmd_desc "$1"
  echo "${C_GREEN}环境就绪。开始操作吧，完成后运行：${C_BOLD}cka check $1${C_RST}"
  echo "${C_DIM}（如需重来：cka reset $1）${C_RST}"
}

cmd_check(){
  local d=$(find_task_dir "$1") || { echo "找不到题目 $1"; exit 1; }
  echo "${C_YEL}==> 正在检查题 $1 ...${C_RST}"
  echo "────────────────────────────────────────────────────────────"
  local out
  out=$(bash "$d/check.sh")
  local passed=0 total=0
  while IFS='|' read -r tag ok msg; do
    [ "$tag" = "RESULT" ] || continue
    total=$((total+1))
    if [ "$ok" = "1" ]; then
      passed=$((passed+1)); echo "  ${C_GREEN}✔${C_RST} $msg"
    else
      echo "  ${C_RED}✘${C_RST} $msg"
    fi
  done <<< "$out"
  echo "────────────────────────────────────────────────────────────"
  ( source "$d/meta.sh"
    local score=$(( passed * 100 / (total>0?total:1) ))
    local w=$(( passed * WEIGHT / (total>0?total:1) ))
    if [ "$passed" -eq "$total" ] && [ "$total" -gt 0 ]; then
      echo "${C_GREEN}${C_BOLD}🎉 全部通过！得分 ${score}%（本机有效分值 ${w}/${WEIGHT}）${C_RST}"
      mark_done "$1"
    elif [ "$score" -ge 70 ]; then
      echo "${C_YEL}${C_BOLD}部分通过 ${passed}/${total}（${score}%）。修正标红项后重跑 cka check $1${C_RST}"
    else
      echo "${C_RED}未通过 ${passed}/${total}（${score}%）。运行 cka hint $1 看提示${C_RST}"
    fi
  )
}

cmd_hint(){
  local d=$(find_task_dir "$1") || { echo "找不到题目 $1"; exit 1; }
  ( source "$d/meta.sh"; echo ""; echo "${C_CYAN}💡 提示（题 $1）：${C_RST}"; echo "$HINT"; echo "" )
}

cmd_reset(){
  local d=$(find_task_dir "$1") || { echo "找不到题目 $1"; exit 1; }
  echo "${C_YEL}==> 重置题 $1 环境 ...${C_RST}"
  bash "$d/clean.sh" >/dev/null 2>&1
  bash "$d/setup.sh"
  echo "${C_GREEN}已重置，环境重新就绪。${C_RST}"
}

cmd_clean(){
  local d=$(find_task_dir "$1") || { echo "找不到题目 $1"; exit 1; }
  echo "${C_YEL}==> 清理题 $1 资源 ...${C_RST}"
  bash "$d/clean.sh"
  echo "${C_GREEN}已清理。${C_RST}"
}

cmd_done(){
  local d=$(find_task_dir "$1") || { echo "找不到题目 $1"; exit 1; }
  mark_done "$1"
  echo "${C_GREEN}✔ 题 $1 已标记为完成（理论题）${C_RST}"
}

cmd_score(){
  local dirs=$(ls -d "$CKA_ROOT"/tasks/*/ 2>/dev/null | sort)
  local got=0 full=0 total=0 passed=0
  mkdir -p "$PROGRESS_DIR"; rm -f "$PROGRESS_DIR/.tmp_score"
  echo ""
  printf "%s %s %s %s\n" "${C_BOLD}$(padw 'ID' 4)${C_RST}" "${C_BOLD}$(padw '题目' 44)${C_RST}" \
    "${C_BOLD}$(padw '分值' 6)${C_RST}" "${C_BOLD}得分${C_RST}"
  echo "----------------------------------------------------------------------------------"
  for d in $dirs; do
    local meta="$d/meta.sh"
    [ -f "$meta" ] || continue
    ( source "$meta"
      local id=$(basename "$d" | cut -d- -f1)
      local s=0
      if is_done "$id"; then s=$WEIGHT; fi
      printf "%s %s %s %b\n" "$(padw "$id" 4)" "$(padw "$TITLE" 44)" "$(padw "$WEIGHT" 6)" \
        "$([ "$s" -gt 0 ] && echo "${C_GREEN}$s${C_RST}" || echo "${C_DIM}0${C_RST}")"
      echo "SCORE|$s|$WEIGHT" >> "$PROGRESS_DIR/.tmp_score"
    )
  done
  if [ -f "$PROGRESS_DIR/.tmp_score" ]; then
    while IFS='|' read -r _ s w; do
      got=$((got + s)); full=$((full + w))
      [ "$s" -gt 0 ] && passed=$((passed + 1))
      total=$((total + 1))
    done < "$PROGRESS_DIR/.tmp_score"
    rm -f "$PROGRESS_DIR/.tmp_score"
  fi
  echo "----------------------------------------------------------------------------------"
  echo "  已通过：${C_BOLD}$passed/$total${C_RST} 题    总分：${C_BOLD}${C_GREEN}$got${C_RST} / $full"
  [ "$full" -gt 0 ] && [ $((got * 100 / full)) -ge 70 ] && \
    echo "  ${C_GREEN}${C_BOLD}达到 CKA 及格线（70%）${C_RST}"
  echo ""
}

case "$1" in
  list|ls)   list_tasks ;;
  desc)      cmd_desc "$2" ;;
  start)     cmd_start "$2" ;;
  check)     cmd_check "$2" ;;
  hint)      cmd_hint "$2" ;;
  reset)     cmd_reset "$2" ;;
  clean)     cmd_clean "$2" ;;
  done)      cmd_done "$2" ;;
  score)     cmd_score ;;
  *)
    echo ""
    echo "${C_BOLD}${C_CYAN}  CKA 真题练习环境${C_RST}"
    echo "  ──────────────────────────────────────────────"
    echo "  cka list            列出全部题目与进度"
    echo "  cka desc  <ID>      查看题目要求"
    echo "  cka start <ID>      部署某题的初始环境"
    echo "  cka check <ID>      自动评分（检验答案）"
    echo "  cka hint  <ID>      查看解题提示"
    echo "  cka reset <ID>      重置该题环境"
    echo "  cka clean <ID>      清理该题资源"
    echo "  cka done  <ID>      理论题标记完成"
    echo "  cka score           查看总分与及格情况"
    echo ""
    echo "  ${C_DIM}示例：cka start 01 && cka check 01${C_RST}"
    echo ""
    ;;
esac
