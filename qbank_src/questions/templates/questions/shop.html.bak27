{% extends 'questions/base.html' %}
{% load static %}
{% block title %}星星商店 - 题库系统{% endblock %}
{% block title_key %}shop{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-lg rounded-4 overflow-hidden">
            <div class="card-header text-white text-center py-4" style="background:linear-gradient(135deg,#f59e0b 0%,#d97706 100%);">
                <div style="font-size:2.5rem;line-height:1;">🛒</div>
                <h1 class="card-title mt-2 mb-0">星星商店</h1>
                <p class="mt-2 mb-2 text-white-50">答题赚星星，给宠物买点好东西</p>
                <div class="d-inline-block bg-white text-dark rounded-pill px-4 py-1 fw-bold" id="shop-stars">⭐ 0</div>
            </div>
            <div class="card-body p-4" id="shop-root">
                <div class="text-center text-muted py-5">
                    <div class="spinner-border text-warning" role="status"></div>
                    <div class="mt-2">加载中…</div>
                </div>
            </div>
        </div>
        <div class="text-center mt-3">
            <a href="{% url 'pet_page' %}" class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-egg me-2"></i>去看看我的宠物
            </a>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script src="{% static 'js/pet.js' %}?v=20261017p"></script>
{% endblock %}
